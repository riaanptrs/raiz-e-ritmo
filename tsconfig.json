{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "isolatedModules": true, "verbatimModuleSyntax": true, "strict": true,
    "noEmit": true, "skipLibCheck": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "scripts/*.ts", "tests", "vite.config.ts"]
}
